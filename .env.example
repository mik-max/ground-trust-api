# Local development database (safe to reset). Create it with: createdb groundtrust_dev
DATABASE_URL="postgresql://user@localhost:5432/groundtrust_dev"
# Live production database, used only when passed explicitly (see DEPLOYMENT.md).
PRODUCTION_DATABASE_URL=""
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=8000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
# NLP pipeline (translation + aspect/sentiment classification, files/HANDOFF.md §3).
# Without this set, review submission still works — processing is skipped and
# nlpAspects/translatedText just stay null. See BACKLOG.md.
ANTHROPIC_API_KEY=""
# Speech-to-text for voice reviews (Whisper via Groq's free tier, files/HANDOFF.md §3).
# Get a key at console.groq.com — free tier covers this project's expected volume
# (2,000 requests/day) at no cost. Check current terms at console.groq.com.
# Without this set, voice reviews still record/play back fine — they just never
# get a transcript, so translation/classification never run for them either.
GROQ_API_KEY=""
# Content moderation (files/ADDENDUM.md §3). OpenAI's moderation endpoint is
# free — get a key at platform.openai.com. Without this set, the automated
# check is skipped and reviews keep the schema's default "approved" status
# (i.e. same behavior as before this feature existed) — text still only
# reaches the human review queue if this key is present and the check flags it.
OPENAI_API_KEY=""
# Google sign-in (files/DESIGN_SYSTEM.md §6.1). From the OAuth client at
# console.cloud.google.com — APIs & Services > Credentials. Without
# GOOGLE_CLIENT_ID set, POST /api/auth/google returns 503; email/password
# auth is unaffected either way.
GOOGLE_CLIENT_ID=""
# Not used by this project — ID-token verification (what this app does)
# only needs the client ID as the expected audience, not the secret. The
# secret is only for a server-side authorization-code exchange, which this
# app doesn't do. Kept here in case that ever changes; safe to leave blank.
GOOGLE_CLIENT_SECRET=""
# Voice recordings are stored privately in Cloudinary (cloudinary.com dashboard).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder for uploads from this environment; the live site uses the default "groundtrust/audio".
CLOUDINARY_AUDIO_FOLDER="groundtrust/dev"
# Area photos (public images). Production uses the default, groundtrust/areas.
CLOUDINARY_PHOTO_FOLDER="groundtrust/dev-areas"
