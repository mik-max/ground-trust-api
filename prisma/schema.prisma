generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  resident
  government
  admin
}

enum AuthProvider {
  email
  google
}

enum VerificationTier {
  tier0
  tier1
  tier2
  tier3
}

enum VerificationEventType {
  gps_sample
  tier_upgrade
  manual_review
}

enum Aspect {
  power
  water
  security
  roads_flooding
  accessibility
}

enum Band {
  poor
  fair
  good
  excellent
}

enum ConfidenceLevel {
  low
  medium
  high
}

enum ModerationStatus {
  approved
  pending
  rejected
}

// A government account's acknowledgement of a flag. Deliberately separate
// from Flag.resolved: only residents' recovering scores resolve a flag —
// government can say it has seen and is acting on one, not close it.
enum ReviewReportReason {
  false_information
  offensive
  spam
  other
}

enum FlagResponseStatus {
  unacknowledged
  acknowledged
  in_progress
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  passwordHash String?
  authProvider AuthProvider @default(email)
  role         Role
  createdAt    DateTime     @default(now())

  reviews             Review[]
  verificationEvents  VerificationEvent[]
  residencies         UserAreaResidency[]
  createdAreas        Area[]
  flagResponses       Flag[]
  reviewReports       ReviewReport[]
}

// Append-only log powering tier computation. Raw GPS coordinates are never
// stored here or anywhere else — only the derived night-presence signal.
model VerificationEvent {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  areaId         String
  area           Area                  @relation(fields: [areaId], references: [id])
  eventType      VerificationEventType
  sampledAtNight Boolean               @default(false)
  createdAt      DateTime              @default(now())

  @@index([userId, areaId])
}

// Derived/summary table, recomputed from VerificationEvent. Kept separate so
// the hot read path (area profile) never touches the raw event log.
model UserAreaResidency {
  userId           String
  areaId           String
  verificationTier VerificationTier @default(tier0)
  confirmedSince   DateTime?
  trustWeight      Float            @default(0.3)

  user User @relation(fields: [userId], references: [id])
  area Area @relation(fields: [areaId], references: [id])

  @@id([userId, areaId])
}

model Area {
  id              String            @id @default(cuid())
  name            String
  city            String
  state           String
  geoCentroidLat  Float
  geoCentroidLng  Float
  geoRadiusMeters Int
  createdAt       DateTime          @default(now())
  // Admin-curated seed areas default straight to approved (no one to
  // approve them against). A resident-proposed area (see area.controller.ts
  // createArea) starts pending and is excluded from every public listing
  // until an admin approves it — same moderation shape reviews already use.
  status          ModerationStatus  @default(approved)
  createdByUserId String?
  createdBy       User?             @relation(fields: [createdByUserId], references: [id])

  reviews            Review[]
  scores             AreaScore[]
  flags              Flag[]
  residencies        UserAreaResidency[]
  verificationEvents VerificationEvent[]
}

model Review {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  originalText     String?
  originalLanguage String?
  originalAudioRef String?
  translatedText   String?
  submittedAt      DateTime @default(now())

  // Structured ratings, 1-5, nullable if that aspect wasn't rated.
  ratingPower           Int?
  ratingWater           Int?
  ratingSecurity        Int?
  ratingRoadsFlooding   Int?
  ratingAccessibility   Int?

  // [{aspect, sentiment, confidence}, ...] — populated once the NLP pipeline exists.
  nlpAspects Json?

  // Snapshot at submission time so historical scores stay explainable even if
  // the contributor's trust weight changes later.
  trustWeightAtSubmission Float

  // Only 'approved' reviews are included in recomputeAreaScore.
  moderationStatus ModerationStatus @default(approved)
  // Set when a review is held for an administrator for a reason other than
  // its content (e.g. a burst of reviews from new accounts); automated
  // moderation never releases a held review.
  holdReason       String?

  reports ReviewReport[]

  @@index([areaId])
  @@index([userId])
}

model AreaScore {
  areaId           String
  aspect           Aspect
  score            Float
  band             Band
  contributorCount Int
  confidenceLevel  ConfidenceLevel
  lastUpdated      DateTime        @updatedAt

  area Area @relation(fields: [areaId], references: [id])

  @@id([areaId, aspect])
}

model Flag {
  id                             String    @id @default(cuid())
  areaId                         String
  area                           Area      @relation(fields: [areaId], references: [id])
  aspect                         Aspect
  triggeredAt                    DateTime
  consecutiveWeeksBelowThreshold Int
  resolved                       Boolean   @default(false)
  resolvedAt                     DateTime?

  responseStatus      FlagResponseStatus @default(unacknowledged)
  responseNote        String?
  respondedAt         DateTime?
  respondedByUserId   String?
  respondedBy         User?              @relation(fields: [respondedByUserId], references: [id])

  @@index([areaId, resolved])
}

// A signed-in user's report that a review is false or abusive. A report
// never hides a review by itself (that would let anyone silence true
// reviews); it puts the review in the administrator's moderation queue,
// where it is either kept (reports resolved) or removed (review rejected).
model ReviewReport {
  id             String             @id @default(cuid())
  reviewId       String
  review         Review             @relation(fields: [reviewId], references: [id])
  reporterUserId String
  reporter       User               @relation(fields: [reporterUserId], references: [id])
  reason         ReviewReportReason
  note           String?
  resolved       Boolean            @default(false)
  createdAt      DateTime           @default(now())

  @@unique([reviewId, reporterUserId])
  @@index([resolved])
}
